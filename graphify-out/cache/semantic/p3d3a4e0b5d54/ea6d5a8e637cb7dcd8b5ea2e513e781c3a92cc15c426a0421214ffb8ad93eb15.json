{"nodes": [{"id": "reports_hag_47_employee_half_create", "label": "HAG-47 report: POST /api/employees half-create", "file_type": "document", "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_hag_47_employee_controller", "label": "employeeController.js (+73/-33, transactional create)", "file_type": "code", "source_file": "reports/HAG-47-employee-half-create.md", "source_location": "Maa-Baglamkhi-Resort-Backend/src/controller/employeeController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_hag_47_create_user_record_tx", "label": "createUserRecordTx (two INSERTs on one pooled connection)", "file_type": "code", "source_file": "reports/HAG-47-employee-half-create.md", "source_location": "src/controller/employeeController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both the users and employees INSERTs now run in one transaction on a single pooled connection, each header read via const [header] = await connection.query(...); any throw rolls back and returns 500 with the real error code; connection.release() in finally so failed requests no longer leak pooled connections; the {id: users.id, name} fallback is gone so a 201 always means both rows exist."}, {"id": "reports_hag_47_payroll_controller", "label": "payrollController.js (+23/-3, requireEmployeeRow)", "file_type": "code", "source_file": "reports/HAG-47-employee-half-create.md", "source_location": "Maa-Baglamkhi-Resort-Backend/src/controller/payrollController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_hag_47_require_employee_row", "label": "requireEmployeeRow (strict 404 when no employees row)", "file_type": "code", "source_file": "reports/HAG-47-employee-half-create.md", "source_location": "src/controller/payrollController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old call site employeeId = (await resolveEmployee(employeeId)) || employeeId silently swallowed null and kept using the raw users.id, which became salary_payments.employee_id; createPayment now calls requireEmployeeRow so no employees row \u2192 404 and no payment is written, while resolveEmployee keeps its contract for estimateSalary."}, {"id": "reports_hag_47_pool_tuple_contract", "label": "mysql2 pool tuple contract ([rows,fields] / [header,undefined])", "file_type": "rationale", "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On the pool, SELECT resolves [rows, fields] and INSERT resolves [header, undefined] so insertId sits at [0]; on a raw single connection the INSERT resolves to a bare header \u2014 that is why const [result] = await db.query(...); result.insertId is wrong on the pool but accidentally right in a probe script, making the bug invisible when tested that way."}, {"id": "reports_hag_47_users_table", "label": "users table (54 orphans without an employees row)", "file_type": "concept", "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "reports_hag_47_employee_half_create", "target": "reports_hag_47_employee_controller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "weight": 1}, {"source": "reports_hag_47_employee_half_create", "target": "reports_hag_47_payroll_controller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "weight": 1}, {"source": "reports_hag_47_employee_half_create", "target": "reports_hag_47_users_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "weight": 1}, {"source": "reports_hag_47_employee_half_create", "target": "reports_hag_47_pool_tuple_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "weight": 1}, {"source": "reports_hag_47_employee_controller", "target": "reports_hag_47_create_user_record_tx", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "weight": 1}, {"source": "reports_hag_47_payroll_controller", "target": "reports_hag_47_require_employee_row", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "weight": 1}, {"source": "reports_hag_47_create_user_record_tx", "target": "reports_hag_47_users_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "weight": 1}, {"source": "reports_hag_47_require_employee_row", "target": "reports_hag_47_payroll_controller", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "weight": 1}, {"source": "reports_hag_47_employee_controller", "target": "readme_payroll_attendance_module", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "reports/HAG-47-employee-half-create.md", "source_location": null, "weight": 1}, {"source": "reports_hag_47_employee_half_create", "target": "readme_payroll_attendance_module", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.