{"nodes": [{"id": "reports_hag_52_banquet_arity", "label": "HAG-52 report: banquet INSERT arity mismatch", "file_type": "document", "source_file": "reports/HAG-52-banquet-arity.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_hag_52_banquet_bookings_controller", "label": "banquetBookingsController.js (33-column INSERT fixed at :394)", "file_type": "code", "source_file": "reports/HAG-52-banquet-arity.md", "source_location": "Maa-Baglamkhi-Resort-Backend/src/controller/banquetBookingsController.js:394", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The INSERT listed 33 columns but supplied 32 ? placeholders against 33 bind values, so MySQL rejected every booking create with ER_WRONG_VALUE_COUNT_ON_ROW and silently dropped created_by; the fix adds the one missing placeholder, and every other INSERT/UPDATE in the banquet files was audited and is arithmetically consistent."}, {"id": "reports_hag_52_banquet_halls_controller", "label": "banquetHallController.js (INSERT/UPDATE, arity consistent)", "file_type": "code", "source_file": "reports/HAG-52-banquet-arity.md", "source_location": "Maa-Baglamkhi-Resort-Backend/src/controller/banquetHallController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_hag_52_banquet_pricing_controller", "label": "banquetPricingController.js (INSERT ... ON DUPLICATE KEY UPDATE)", "file_type": "code", "source_file": "reports/HAG-52-banquet-arity.md", "source_location": "Maa-Baglamkhi-Resort-Backend/src/controller/banquetPricingController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_hag_52_check_booking_overlap", "label": "checkBookingOverlap guard (hall time-slot conflict, lines 326-337)", "file_type": "code", "source_file": "reports/HAG-52-banquet-arity.md", "source_location": "src/controller/banquetBookingsController.j