{"nodes": [{"id": "reports_hag_51_dashboard_guards", "label": "HAG-51 report: dashboard schema guards, guest_profiles leg", "file_type": "document", "source_file": "reports/HAG-51-dashboard-guards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_hag_51_dashboard_controller", "label": "dashboardController.js (29 insertions, 16 deletions)", "file_type": "code", "source_file": "reports/HAG-51-dashboard-guards.md", "source_location": "Maa-Baglamkhi-Resort-Backend/src/controller/dashboardController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_hag_51_table_exists", "label": "tableExists guard (rewritten to information_schema)", "file_type": "code", "source_file": "reports/HAG-51-dashboard-guards.md", "source_location": "src/controller/dashboardController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mysql2's query() returns SHOW output as two result sets, so rows.length was always 2 whether the table existed or not \u2014 every tableExists call went permanently true; the fix queries information_schema.tables with a bound parameter, keeping the same name and signature."}, {"id": "reports_hag_51_column_exists", "label": "columnExists guard (rewritten to information_schema)", "file_type": "code", "source_file": "reports/HAG-51-dashboard-guards.md", "source_location": "src/controller/dashboardController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same two-result-set SHOW COLUMNS defect as tableExists: the guard returned true even when the column was missing; now uses information_schema.columns."}, {"id": "reports_hag_51_detect_date_column", "label": "detectDateColumn guard (one query, Set membership)", "file_type": "code", "source_file": "reports/HAG-51-dashboard-guards.md", "source_location": "src/controller/dashboardController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With SHOW probes it unconditionally returned the first candidate (created_at) and threw ER_NO_SUCH_TABLE on a missing table; the fix does one information_schema query and Set membership, still falling back to null when nothing matches."}, {"id": "reports_hag_51_guests_leg_fix", "label": "guests \u2192 bookings leg fix (hotel booking check-in source)", "file_type": "rationale", "source_file": "reports/HAG-51-dashboard-guards.md", "source_location": "src/controller/dashboardController.js", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "guest_profiles is an identity table with no check_in/check_in_date/booking_id columns, so renaming the leg to it as dispatched would throw ER_BAD_FIELD_ERROR once the guard became honest; bookings is the correct source (has check_in, already feeds leg 3, and room_tariff.booking_id joins to it) \u2014 the legacy false-positive guard had been hiding the fatal rename."}, {"id": "reports_hag_51_room_tariff_table", "label": "room_tariff table (0 rows, why totalRevenueGenerated < todayRevenue)", "file_type": "concept", "source_file": "reports/HAG-51-dashboard-guards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_hag_51_guest_profiles_table", "label": "guest_profiles table (71 identity rows, no booking dates)", "file_type": "concept", "source_file": "reports/HAG-51-dashboard-guards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "reports_hag_51_dashboard_guards", "target": "reports_hag_51_dashboard_controller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "reports/HAG-51-dashboard-guards.md", "source_location": null, "weight": 1}, {"source": "reports_hag_51_dashboard_guards", "target": "reports_hag_51_table_exists", 