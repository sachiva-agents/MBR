# Zero-config (HAG-22): this whole file is OPTIONAL on first start. The app
# boots with no .env at all: DB defaults to 127.0.0.1:3306 root/'' , the
# database "resort_management" is auto-created, all tables + the admin user
# auto-seed, and an empty/absent JWT_SECRET is auto-generated + persisted
# here. Copy this file only to override defaults.
PORT=5002
NODE_ENV=production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resort_management
DB_NAME_TEST=hotel_management_test
DB_CONNECTION_LIMIT=10
# Leave empty for zero-config (auto-generated on first boot, saved here).
# For a live site, set a 64+ char random value and change it if leaked:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Origins allowed to call this API directly (bypassing the Vite proxy).
# This list REPLACES the built-in dev list; it never stacks with the
# localhost / private-LAN auto-allow, which only applies while this value is
# empty. Name every origin you expect to reach this port.
# Set CORS_ALLOW_LOCAL=true to keep the localhost / 192.168 / 10 / 172 LAN
# auto-allow in force even when this list is populated.
# Normal browser traffic goes through the Vite proxy and stays same-origin.
CORS_ORIGINS=
CORS_ALLOW_LOCAL=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
ALLOW_REGISTER=false
SKIP_PAYMENT_SCHEMA_BOOTSTRAP=false
PAYMENTS_TABLE_NAME=payments

# ============================================================
# PRINT SYSTEM CONFIGURATION
# ============================================================
AUTO_PRINT_ENABLED=true
# Set to false to stop KOT auto-print entirely (graceful degradation, no
# retry storm when the kitchen printer is absent).
# AUTO_PRINT_ENABLED=false
PRINT_A4_PRINTER_NAME="HP Smart Tank 580 Series"
PRINT_A4_PRINTER_ENABLED=true
PRINT_THERMAL_PRINTER_NAME="RP326 ESC/POS Thermal Receipt Printer"
PRINT_THERMAL_PRINTER_ENABLED=true
PRINT_QUEUE_POLL_INTERVAL_MS=2000
PRINT_MAX_RETRIES=3
PRINT_RETRY_DELAY_MS=5000
INVOICE_UPLOAD_DIR=./backend/uploads/invoices
THERMAL_UPLOAD_DIR=./backend/uploads/thermal
# HAG-13: explicit KOT printer override (wins over KITCHEN_PRINTER_NAME).
# Point at a real Windows printer name, or leave empty to use KITCHEN_PRINTER_NAME.
KOT_PRINTER_NAME=
KITCHEN_PRINTER_NAME="kitchen"

# ============================================================
# WHATSAPP / WASACHIVA GATEWAY
# ============================================================
# Legacy keys still work; the new WHATSAPP_* overrides win when both are set.
wasachiva_url=https://wasend.sachiva.cloud
wasachiva_key=replace-with-your-wasachiva-api-key
# Optional overrides (preferred when you need a different/secondary gateway):
# WHATSAPP_GATEWAY_URL=
# WHATSAPP_API_KEY=
