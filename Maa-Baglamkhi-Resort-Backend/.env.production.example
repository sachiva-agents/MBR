# MBR backend — PRODUCTION environment template (HAG-17)
#
# Copy to .env on the host and fill every value marked (REQUIRED).
# Never commit the filled .env. The .env value is the ONLY source of
# secrets — nothing below may be hardcoded back into the code.

# ── Core ───────────────────────────────────────────────────────────
NODE_ENV=production
# Port the API listens on. Bind behind a reverse proxy; the app itself
# should stay reachable only on the host (127.0.0.1 for the DB).
PORT=5002

# ── Database (MariaDB/MySQL) ───────────────────────────────────────
# Host conventions: 127.0.0.1 only (IPv4 loopback). Never a raw LAN IP
# for the DB. DB creds are fully env-driven; safe defaults exist
# (root / empty password on 127.0.0.1:3301) but you MUST override them
# for production.
DB_HOST=127.0.0.1            # (REQUIRED) 127.0.0.1
DB_PORT=3306                 # (REQUIRED) 3306 for MariaDB/XAMPP; 3301 is a fallback default
DB_USER=mb_app               # (REQUIRED) least-privilege user, NOT root
DB_PASSWORD=change-me        # (REQUIRED) strong password
DB_NAME=resort_management    # (REQUIRED) your production schema
DB_NAME_TEST=               # test-only: scratch DB the test suites use; empty in prod
DB_CONNECTION_LIMIT=10       # pool size; 10-20 for a single-site resort

# ── Security ───────────────────────────────────────────────────────
# (REQUIRED) 64+ hex chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=                  # REQUIRED — server will REFUSE TO SIGN if empty
JWT_EXPIRES_IN=7d
# Comma-separated list of browser origins allowed to call the API directly.
# Leave empty only if ALL browser traffic goes through the same-origin
# reverse proxy. In production an empty list means NO cross-origin browser
# caller is allowed (the dev auto-allow list is NOT active in production
# unless CORS_ALLOW_LOCAL=true).
CORS_ORIGINS=https://your-resort-domain.example   # (REQUIRED if any cross-origin caller)
CORS_ALLOW_LOCAL=false
# Auth rate limit: /api/auth/login + /register (window ms, max attempts).
# Local/test requests are exempt; external clients are throttled.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Token routes (/api/token/*) limiter (HAG-17): window ms, max per client.
TOKEN_RATE_LIMIT_WINDOW_MS=900000
TOKEN_RATE_LIMIT_MAX=120
# Open self-service registration? Default false — users are created by an
# admin (or the first-user bootstrap on a fresh DB).
ALLOW_REGISTER=false
SKIP_PAYMENT_SCHEMA_BOOTSTRAP=false
PAYMENTS_TABLE_NAME=payments

# ── Public URLs / branding ─────────────────────────────────────────
# Base URL the server tells clients to use for /uploads (invoice PDFs,
# photos) and WhatsApp attachment links. MUST be the public
# https:// origin served by the reverse proxy.
PUBLIC_BASE_URL=https://your-resort-domain.example
PUBLIC_URL=
CLIENT_URL=
BUSINESS_NAME=Maa Baglamukhi Resort
BUSINESS_CONTACT=

# ── Print system ───────────────────────────────────────────────────
# Master switch for KOT auto-print. Set false on a host without a
# kitchen printer — the queue degrades gracefully, no retry storm.
AUTO_PRINT_ENABLED=false     # (REQUIRED for hosts without a KOT printer)
# KOT printer override — wins over the legacy KITCHEN_PRINTER_NAME.
# The exact Windows/Linux printer name the driver sees.
KOT_PRINTER_NAME=
KITCHEN_PRINTER_NAME=kitchen
# Optional per-type override: PRINT_PRINTER_OVERRIDE_KOT=KITCHEN_PRINTER

# ── WhatsApp / Wasachiva gateway ───────────────────────────────────
# Invoice + booking-confirmation delivery. New names win over legacy
# lowercase wasachiva_url / wasachiva_key.
WHATSAPP_GATEWAY_URL=https://wasend.sachiva.cloud
WHATSAPP_API_KEY=change-me   # (REQUIRED for WhatsApp delivery)
WASACHIVA_URL=               # legacy fallback (ignored when WHATSAPP_GATEWAY_URL set)
WASACHIVA_KEY=               # legacy fallback (ignored when WHATSAPP_API_KEY set)
WASACHIVA_USERNAME=
WASACHIVA_TIMEOUT_MS=10000
# Last-resort admin WhatsApp number if no user has a phone in the DB.
ADMIN_WHATSAPP_NUMBER=

# ── Uploads / backups ──────────────────────────────────────────────
INVOICE_UPLOAD_DIR=./uploads/invoices
THERMAL_UPLOAD_DIR=./uploads/thermal
# Optional: where mysqldump lives when it is not on PATH (XAMPP on
# Windows). Without it, POST /api/backups/run falls back to an
# in-database clone (mbb_backup_<stamp>) automatically.
MYSQLDUMP_BIN=
MYSQL_BIN=

# ── Biometric (ZK) attendance sync ─────────────────────────────────
# Poll every 15 min over the last 4 h. Disable on hosts without a
# ZK device.
ZK_AUTO_SYNC_DISABLED=true   # flip to false when a ZK device is wired
ZK_AUTO_SYNC_INTERVAL_MINUTES=15
ZK_AUTO_SYNC_WINDOW_HOURS=4
